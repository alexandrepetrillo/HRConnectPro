{
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/verify",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.numeroSecuriteSociale",
          "contains": "999"
        }
      }
    ]
  },
  "response": {
    "status": 503,
    "fixedDelayMilliseconds": 5000,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "Service temporairement indisponible",
      "errorCode": "SERVICE_UNAVAILABLE"
    }
  },
  "priority": 1
}
